						"url": {
							"raw": "{{base_url}}/api/produk",
							"host": ["{{base_url}}"],
							"path": ["api", "produk"]
						},
						"description": "Mengambil seluruh daftar produk dari basis data (HTTP 200)."
					},
					"response": []
				},
				{
					"name": "2. Tambah Produk (POST - Sukses 201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set(\"produk_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nama\": \"Laptop Asus Zenbook 14 OLED\",\n    \"kategori\": \"Laptop\",\n    \"harga\": 18500000,\n    \"stok\": 10,\n    \"deskripsi\": \"Laptop ultra-portable bertenaga Intel Core Ultra\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/produk",
							"host": ["{{base_url}}"],
							"path": ["api", "produk"]
						},
						"description": "Menambahkan data produk baru, mengembalikan kode status HTTP 201 Created."
					},
					"response": []
				},
				{
					"name": "3. Tambah Produk - Gagal Validasi (POST - 422)",
