						"description": "Menguji penanganan kesalahan validasi ketika kolom wajib kosong, mengembalikan HTTP 422 Unprocessable Content."
					},
					"response": []
				},
				{
					"name": "4. Tampil Satu Produk (GET By ID)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
